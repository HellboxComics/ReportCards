# Which data source grades wallets: "mock" (deterministic demo data) or "blockscout".
DATA_PROVIDER=mock

# Blockscout-compatible explorer for Robinhood Chain (API v2 base, no trailing slash).
# e.g. https://explorer.example.com/api/v2
BLOCKSCOUT_API_URL=

# Comma-separated token contract addresses to classify as tokenized stocks.
STOCK_TOKEN_ADDRESSES=
