# Copy to contracts/.env (gitignored). forge loads it automatically.
# Leave optional values commented out rather than empty: an empty number fails to parse.

# ── Network (never hardcoded anywhere) ──────────────────────────────────────────
ROBINHOOD_CHAIN_RPC_URL=
# Blockscout verification endpoint for the chain's explorer, e.g. https://<explorer>/api/
# ROBINHOOD_CHAIN_VERIFIER_URL=
# Refuse to deploy unless the RPC reports this chain id (strongly recommended for mainnet).
# REPORT_CARDS_EXPECTED_CHAIN_ID=

# ── Required ────────────────────────────────────────────────────────────────────
# Owner of the collection. Use a multisig. It mints reserves, reveals, and withdraws.
REPORT_CARDS_OWNER=
# Pre-reveal metadata for every card (the "dog ate it" JSON), e.g. ipfs://<cid>/unrevealed.json
REPORT_CARDS_UNREVEALED_URI=

# ── Optional: placeholders until the economics are decided ──────────────────────
# REPORT_CARDS_NAME=Report Cards
# REPORT_CARDS_SYMBOL=GRADES
# Defaults to REPORT_CARDS_OWNER.
# REPORT_CARDS_ROYALTY_RECEIVER=
# Basis points: 333 = 3.33%. The contract refuses anything above 1000 (10%).
# REPORT_CARDS_ROYALTY_BPS=333
# Wei: 3333000000000000 = 0.003333 ETH.
# REPORT_CARDS_MINT_PRICE_WEI=3333000000000000
# REPORT_CARDS_MAX_PER_WALLET=3
